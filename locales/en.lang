# MiniToo Studio — English.
#
# To translate MiniToo Studio, copy this file to ~/.config/minitoo-studio/locales/<code>.lang
# (for example de.lang), change @name and the texts, then pick the language in Settings.
# See README.md next to this file.

@name = English
@plural = en

